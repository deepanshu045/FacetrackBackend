# Database
# Use PlanetScale or another hosted MySQL-compatible URL with DATABASE_URL,
# or configure the individual DB_* values below.
DATABASE_URL=mysql+pymysql://your_user:your_password@your_host:3306/your_database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=face_attendance

# Backend security and CORS
JWT_SECRET_KEY=your-secret-key-change-this
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Gmail SMTP: use a Google App Password, not your regular Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_SENDER=your-gmail@gmail.com
ABSENCE_CHECK_HOUR=11

# ImageKit storage for student photos. Keep the private key on the backend only.
IMAGEKIT_PRIVATE_KEY=private_your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
IMAGE_MAX_DIMENSION=1600
IMAGE_JPEG_QUALITY=85
